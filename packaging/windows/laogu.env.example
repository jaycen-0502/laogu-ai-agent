# Public Server address. Do not put passwords, JWTs or Agent Tokens here.
LAOGU_SERVER_URL=https://api.jaycwl.org

# Optional one-time import of a web-generated Agent credential.
# After the first successful Agent start, remove these two lines.
LAOGU_AGENT_ID=
LAOGU_AGENT_TOKEN=

# Local Laogu Browser API.
LAOGU_BASE_URL=http://127.0.0.1:19876

# Keep empty unless your local Laogu Browser explicitly requires its API key.
LAOGU_API_KEY=

# Optional signed-by-pin engine update. Leave empty to disable remote code updates.
LAOGU_ENGINE_UPDATE_URL=
LAOGU_ENGINE_UPDATE_SHA256=
